# EasyAgent 配置：复制为 .env 并替换占位值；不要提交真实凭据。
# 当前读取 EA_*，旧 PI_GO_* 变量需手动迁移。详见 docs/CONFIG.md。

EA_PROVIDER=openai
EA_BASE_URL=http://localhost:4001
EA_MODEL=your-model-id
# OpenAI 兼容上游密钥；未单独设置服务令牌时也用于 API 认证。
EA_API_KEY=your-api-key
# 可选：EasyAgent HTTP API 独立令牌，不改变上游密钥。
# EA_SERVER_API_KEY=your-agent-server-key

# Anthropic：设置 EA_PROVIDER=anthropic 后填写。
# ANTHROPIC_API_KEY=your-key
# ANTHROPIC_MODEL=your-model-id
# ANTHROPIC_BASE_URL=https://api.anthropic.com

EA_HOST=127.0.0.1
EA_PORT=8080
EA_DATA_DIR=./data
# 留空使用当前目录。
EA_WORKSPACE=
EA_ENABLE_BASH=false
EA_AUTO_APPROVE=false
EA_ALLOW_OUTSIDE_WORKSPACE=false
EA_ENABLE_WEB=false
EA_ENABLE_WEB_SEARCH=false
# 可选：用户级 MCP 配置，默认位于 EA_HOME/mcp.json。
# EA_MCP_CONFIG=/absolute/path/mcp.json

# 动态工作流另需 Node.js 22+ 和已构建的 bundle。
# EA_WORKFLOW_RUNTIME=/absolute/path/workflow-runtime/output/workflow-runtime.mjs

# 飞书桥接（可选）。PI_AGENT_URL 仍是桥接使用的实际变量名。
# FEISHU_APP_ID=cli_your-app-id
# FEISHU_APP_SECRET=your-app-secret
# PI_AGENT_URL=http://127.0.0.1:8080
# 未预置 owner 时，通过私聊的一次性配对绑定使用者。
# FEISHU_OWNER_STATE_FILE=/absolute/path/feishu-owner.json
# 网页托管设置：与 systemd bridge 的 EnvironmentFile 保持一致。
# EA_FEISHU_ENV_FILE=/absolute/path/feishu.env
