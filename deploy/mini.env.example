EA_DEPLOY_API=https://api.github.com/repos/hwj123hwj/easyagent
EA_DEPLOY_REF=refs/heads/main
EA_DEPLOY_GO=/home/q/.local/opt/go1.27.1/go/bin/go
EA_DEPLOY_HEALTH=http://192.168.5.16:8080/health
EA_DEPLOY_SERVICE=easyagent-core.service
# 可选：同时运行飞书桥接的主机可启用同步发布。
# EA_DEPLOY_BRIDGE_BIN=/home/q/.easyagent/bin/easyagent-bridge
# EA_DEPLOY_BRIDGE_SERVICE=easyagent-bridge.service
EA_DEPLOY_REQUIRE_PATH_POLICY=true
EA_DEPLOY_REQUIRE_OWNER_ACCESS=true
# 可选：中国大陆网络可设置可用的 Go 模块代理，校验仍开启。
GOPROXY=https://goproxy.cn,direct
